<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for older Android devices -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    
    <!-- Permissions required for Android 12+ (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    
    <!-- Location only required for BLE discovery on Android 8..11 (API 26..30) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />

    <!-- Internet & Net interfaces for Xiaomi Cloud auth and optional local TCP bridge -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground services and status notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.xiaomi.smarthome" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cuktech"
        tools:targetApi="36">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cuktech"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="cuktech"
                    android:host="action" />
            </intent-filter>
        </activity>

        <service
            android:name=".BleBridgeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BleCommandReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.joxit.cuktech.START_SERVER" />
                <action android:name="com.joxit.cuktech.STOP_SERVER" />
                <action android:name="com.joxit.cuktech.CONNECT_CHARGER" />
                <action android:name="com.joxit.cuktech.DISCONNECT_CHARGER" />
                <action android:name="com.joxit.cuktech.SCAN_CHARGER" />
                <action android:name="com.joxit.cuktech.SET_PORT_STATE" />
                <action android:name="com.joxit.cuktech.SET_SCENE_MODE" />
                <action android:name="com.joxit.cuktech.SET_SCREEN_TIMEOUT" />
                <action android:name="com.joxit.cuktech.SET_CHARGE_LIMIT" />
                <action android:name="com.joxit.cuktech.SET_AUTO_CONNECT" />
                <action android:name="com.joxit.cuktech.SET_PORT_LOGGING" />
                <action android:name="com.joxit.cuktech.SET_TELEMETRY_ENABLED" />
                <action android:name="com.joxit.cuktech.SET_LOG_ONLY_WHEN_CHARGING" />
                <action android:name="com.joxit.cuktech.SET_PAUSE_POLLING_WHEN_LOCKED" />
                <action android:name="com.joxit.cuktech.FORCE_SOFT_RESET" />
                <action android:name="com.joxit.cuktech.MASTER_KILLSWITCH" />
                <action android:name="com.joxit.cuktech.UNDO_LAST_COMMAND" />
                <action android:name="com.joxit.cuktech.QUERY_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Tasker / Locale Action Plugin Activity -->
        <activity
            android:name=".tasker.TaskerEditActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_full_name"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <!-- Tasker / Locale Action Plugin Receiver -->
        <receiver
            android:name=".tasker.TaskerFireReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget Per-Instance Configuration Activity -->
        <activity
            android:name=".widget.CuktechWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Cuktech"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Material 3 / Glance 4x2 Control Center Widget -->
        <receiver
            android:name=".widget.CuktechGlanceControlReceiver"
            android:label="@string/widget_control_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cuktech_4x2_info" />
        </receiver>

        <!-- Material 3 / Glance 2x2 Compact Tile Widget -->
        <receiver
            android:name=".widget.CuktechGlanceCompactReceiver"
            android:label="@string/widget_compact_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cuktech_2x2_info" />
        </receiver>

        <!-- Material 3 / Glance 2x2 Dedicated Single-Port + Mini-Chart Widget -->
        <receiver
            android:name=".widget.CuktechGlancePortReceiver"
            android:label="@string/widget_port_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cuktech_port_info" />
        </receiver>

        <!-- Android Quick Settings Live Telemetry & C1 Toggle Tile -->
        <service
            android:name=".tile.CuktechQuickSettingsTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_cuktech"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
